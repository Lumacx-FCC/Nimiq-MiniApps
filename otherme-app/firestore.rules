rules_version = '2';

// OtherMe credits ledger.
//
// Source of truth is the server: all writes to users / orders / ledger go
// through the Cloud Function using the Admin SDK, which bypasses these rules.
// Rules here are defense-in-depth for the *client* SDK (realtime reads):
//   - a signed-in user (uid == their Nimiq address) may READ only their own
//     data (Phase 2+: the confirming-payment UI subscribes via onSnapshot).
//   - clients may never WRITE ledger, balance, or order state.
// Phase 1 (auth) needs none of these reads yet; they're set for later phases.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Part B adds linkedUids/primaryProvider/mergedInto/mergedAt to this doc —
    // same server-only-write shape, no rule change needed for new fields.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /ledger_entries/{userId}/entries/{txHash} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Login challenges are server-only; never exposed to the client SDK.
    match /auth_challenges/{address} {
      allow read, write: if false;
    }

    // Account-linking resolution (Part A/B): server-only, Admin SDK writes.
    match /identity_links/{uid} {
      allow read, write: if false;
    }

    // Pairing codes + short-lived merge-confirmation tickets (Part B):
    // server-only, single-use, never exposed to the client SDK.
    match /link_codes/{code} {
      allow read, write: if false;
    }
    match /link_tickets/{ticketId} {
      allow read, write: if false;
    }

    // Generic rate-limit counters (Part B onward): server-only.
    match /rate_limits/{key} {
      allow read, write: if false;
    }

    // Cloud-synced character sheets and custom avatars (Part C Stage 1).
    // Client SDK writes directly (no money at stake, unlike the ledger above).
    // create/update check the incoming doc's uid; read/delete check the
    // existing doc's uid (request.resource is unset on a delete).
    match /character_sheets/{sheetId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
    match /avatars/{avatarId} {
      allow read, delete: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create, update: if request.auth != null && request.auth.uid == request.resource.data.uid;
    }
  }
}
